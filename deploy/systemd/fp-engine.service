[Unit]
Description=FilterPhone — מנוע זיהוי תמונות (SigLIP2 + NudeNet)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=filterphone
Group=filterphone
EnvironmentFile=-/etc/filterphone/filterphone.env
ExecStart=/opt/filterphone/venv/bin/python -m filterphone.engine.service
RuntimeDirectory=filterphone
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=2
# המנוע מוותר על מעבד לטובת הפרוקסי כשיש עומס
CPUWeight=80
MemoryMax=3G

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/filterphone /run/filterphone

[Install]
WantedBy=multi-user.target

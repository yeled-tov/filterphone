[Unit]
Description=FilterPhone — API למכשירים ולניהול
After=network-online.target wg-quick@wg0.service redis-server.service
Wants=network-online.target wg-quick@wg0.service redis-server.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=filterphone
Group=filterphone
Environment=FP_LOG_FORMAT=json
EnvironmentFile=-/etc/filterphone/filterphone.env
# בקשות שבטיפול מסתיימות לפני כיבוי (עד 10 שניות); חיבורים פתוחים מוגבלים — עומס = תור, לא קריסה
ExecStart=/opt/filterphone/venv/bin/uvicorn --factory filterphone.api.app:create_app \
    --host 127.0.0.1 --port 8090 \
    --proxy-headers --forwarded-allow-ips 127.0.0.1 \
    --timeout-graceful-shutdown 10 --limit-concurrency 400 --backlog 512 \
    --no-server-header --log-level warning
Restart=always
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=15
TimeoutStopSec=20
MemoryMax=512M

# הרשאה יחידה מעבר למשתמש רגיל: ניהול רשת (wg set) — בלי root
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/filterphone -/run/filterphone

[Install]
WantedBy=multi-user.target

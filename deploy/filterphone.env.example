# FilterPhone — הגדרות השרת (/etc/filterphone/filterphone.env)
# כל שדה ב-server/filterphone/settings.py ניתן לדריסה כאן כ-FP_<NAME>.

FP_PUBLIC_HOST=api.filterphone.com
FP_PUBLIC_IP=151.145.88.42
FP_VPN_ENDPOINT=vpn.filterphone.com:51820

# רמת ברירת מחדל למכשיר לא מוכר: 1 = מחמיר
FP_DEFAULT_LEVEL=1

# מעבד: 4 ליבות בשרת — 3 למודלים, אחת נשארת לפרוקסי
FP_ORT_THREADS=3

# AdGuard Home — שכבת ה-DNS של החסימות לפי מכשיר (רשתות חברתיות, וואטסאפ, חנות...).
# המשתמש והסיסמה של ממשק AdGuard (פורט 3002). בלי זה — החסימות נאכפות רק בפרוקסי
# (HTTPS), ולא בחיבורים אחרים (למשל שיחות וואטסאפ). אחרי שינוי: systemctl restart fp-api
#FP_ADGUARD_USER=admin
#FP_ADGUARD_PASSWORD=

# הרשמה עצמית מהאפליקציה (בקשת הצטרפות שמחכה לאישור בממשק). 0 = רק קודי הפעלה
FP_REGISTER_ENABLED=1

# הקמת מכשיר מנוהל ב-QR: טביעת תעודת החתימה של ה-APK (64 תווי hex, בלי נקודתיים).
# מהלוג של הבנייה ב-GitHub (שלב "אימות חתימה") או: apksigner verify --print-certs FilterPhone-universal.apk
# לא חובה — בלעדיה הטלפון מאמת רק את טביעת הקובץ. ראו docs/DEVICE_OWNER.md
#FP_APK_SIGNATURE_SHA256=

# --- תמיכה בוואטסאפ (WhatsApp Cloud API). עדיף להגדיר בממשק הניהול: מערכת → תמיכה בוואטסאפ.
# ערך כאן גובר על מה שנשמר בממשק. ראו docs/SUPPORT.md
#FP_WA_TOKEN=
#FP_WA_PHONE_NUMBER_ID=
#FP_WA_ADMIN_NUMBER=9725XXXXXXXX
#FP_WA_VERIFY_TOKEN=
#FP_WA_APP_SECRET=
#FP_WA_TEMPLATE=support_message

# keepalive של WireGuard בטלפונים (שניות, 15–50). ראו docs/VPN_BATTERY.md לפני שינוי
#FP_WG_KEEPALIVE_S=25

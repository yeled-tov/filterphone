# FilterPhone — שרת HTTPS. התעודה (Let's Encrypt) מונפקת ומתחדשת אוטומטית.
{
    admin off
}

__PUBLIC_HOST__ {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    # דף הורדת האפליקציה + קובץ ה-APK
    handle_path /download/* {
        root * /var/www/filterphone
        @apk path *.apk
        header @apk Content-Type application/vnd.android.package-archive
        header Cache-Control "no-cache"
        file_server
    }
    redir /download /download/ 308

    handle {
        reverse_proxy 127.0.0.1:8090
    }
}

# FilterPhone — שרת HTTPS. התעודה (Let's Encrypt) מונפקת ומתחדשת אוטומטית.
{
    admin off
}

__PUBLIC_HOST__ {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        -Server
    }

    # דף הורדת האפליקציה + קובץ ה-APK
    handle_path /download/* {
        root * /var/www/filterphone
        @apk path *.apk
        header @apk Content-Type application/vnd.android.package-archive
        header Cache-Control "no-cache"
        file_server
    }
    redir /download /download/ 308

    # מדדים פנימיים — רק מתוך השרת (curl http://127.0.0.1:8090/metrics)
    handle /metrics {
        respond 404
    }

    handle {
        # תמונה לבדיקה בממשק הניהול: עד ~17MB (base64). כל השאר — ה-API מגביל לבד
        request_body {
            max_size 20MB
        }
        reverse_proxy 127.0.0.1:8090 {
            transport http {
                read_timeout 90s
                write_timeout 90s
            }
        }
    }
}

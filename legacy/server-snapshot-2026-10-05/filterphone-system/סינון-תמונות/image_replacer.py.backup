"""
מודול החלפת תמונות
- רמה 1: החלפה בתמונה אפורה (חסימה מלאה)
- רמה 2: טשטוש אזורי עור בלבד (בעתיד — כרגע חסימה מלאה)
"""
from PIL import Image
import io

def create_blocked_image(width=200, height=200):
    """יוצר תמונת PNG אפורה — סימן שהתמונה נחסמה"""
    img = Image.new("RGB", (width, height), (40, 40, 40))
    buf = io.BytesIO()
    img.save(buf, format="PNG")
    return buf.getvalue()

BLOCKED_IMAGE_BYTES = create_blocked_image()

def get_blocked_response():
    """מחזיר bytes של תמונת החסימה + content-type"""
    return BLOCKED_IMAGE_BYTES, "image/png"
